# Domain (must point at the host via DNS A record)
HIRESCRIPT_DOMAIN=hirescript.example.com

# App
APP_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-long-random-string

# Database
POSTGRES_USER=hirescript
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hirescript
DATABASE_URL=postgresql+psycopg://hirescript:change-me-strong-db-password@db:5432/hirescript

# MinIO (S3-compatible)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=change-me-strong-minio-password
STORAGE_BUCKET=hirescript-pdfs
STORAGE_REGION=us-east-1

# Optional: override the host directory containing the user's `claude` CLI auth tokens.
# Default is /srv/hirescript/.claude on the VPS.
HIRESCRIPT_CLAUDE_DIR=/srv/hirescript/.claude

# ──────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────
APP_PASSWORD=changeme
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=generate-a-long-random-string
DATABASE_URL=postgresql+asyncpg://hirescript:hirescript@db:5432/hirescript
POSTGRES_USER=hirescript
POSTGRES_PASSWORD=hirescript
POSTGRES_DB=hirescript

# ──────────────────────────────────────────────────────────────
# MinIO / object storage (PDFs)
# ──────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
STORAGE_ENDPOINT_URL=http://minio:9000
# Public-facing endpoint browsers can reach (presigned download URLs are
# signed against this). Leave unset to fall back to STORAGE_ENDPOINT_URL.
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
STORAGE_BUCKET=hirescript-pdfs
STORAGE_REGION=us-east-1

# ──────────────────────────────────────────────────────────────
# Voyage AI — KB embeddings (https://voyageai.com)
# Leave blank to disable embeddings; KB ingest still runs but
# semantic retrieval will degrade.
# ──────────────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ──────────────────────────────────────────────────────────────
# Claude Agent SDK
# All AI calls route through claude_agent_sdk using your local
# Claude CLI auth at $HOME/.claude (mounted into the api container
# via docker-compose). Run `claude login` on the host before
# starting the stack, or all AI features will fail at runtime.
#
# Token budget for the long-lived Max-window agent session.
# ──────────────────────────────────────────────────────────────
MAX_WINDOW_TOKEN_BUDGET=4000000

# ──────────────────────────────────────────────────────────────
# Gmail digest ingest (optional)
# Polls IMAP for job-alert emails (LinkedIn/Indeed/etc digests).
# Use a Google App Password, NOT your account password.
# Leave GMAIL_USER blank to disable Gmail polling.
# ──────────────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DIGEST_LABEL=INBOX
GMAIL_POLL_INTERVAL_SEC=1800

# ──────────────────────────────────────────────────────────────
# Notion KB sync (optional)
# Create an integration at https://www.notion.so/my-integrations
# and share the target pages/databases with it. NOTION_PAGE_IDS
# is a comma-separated list of page or database IDs.
# Leave NOTION_TOKEN blank to disable Notion sync.
# ──────────────────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_PAGE_IDS=
KB_SYNC_NOTION_INTERVAL_SEC=21600

# ──────────────────────────────────────────────────────────────
# Personal website KB sync (optional)
# Comma-separated root URLs to crawl into the knowledge base.
# Leave blank to disable.
# ──────────────────────────────────────────────────────────────
WEBSITE_ROOT_URLS=

# ──────────────────────────────────────────────────────────────
# Worker / job runner
# ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
INGEST_INTERVAL_SEC=900
# Set to "1" to disable autonomous A-mode submissions (B-mode and
# manual submit still work). Useful for staging or recovery.
AUTONOMOUS_SUBMIT_DISABLED=0
# Set to "1" to run resume jobs inline in the API process instead
# of dispatching to the worker. Dev/test convenience only.
JOBS_INLINE=0

# ──────────────────────────────────────────────────────────────
# Notifications (optional)
# ntfy.sh topic for push notifications. Leave blank to disable.
# ──────────────────────────────────────────────────────────────
NTFY_TOPIC=

# ──────────────────────────────────────────────────────────────
# Test / dev only — do not set in production
# ──────────────────────────────────────────────────────────────
E2E_TESTING=0
